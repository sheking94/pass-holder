<?xml version="1.0" encoding="utf-8"?>
<!-- Release: no plain http:// for outgoing connections. The app makes none: the phone is the sync host.
     Its own HTTP server (SyncHttpServer, Noise on top) only accepts connections from the extension,
     and this setting does not apply to incoming connections. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
