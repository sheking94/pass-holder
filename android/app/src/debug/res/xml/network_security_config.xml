<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: also allow plain http:// for outgoing connections. The app makes none itself
     (the phone is the sync host, see the release config); this only matters for debugging. -->
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <base-config cleartextTrafficPermitted="true" tools:ignore="InsecureBaseConfiguration" />
</network-security-config>
