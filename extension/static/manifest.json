{
  "manifest_version": 3,
  "name": "PassHolder",
  "version": "0.1.0",
  "description": "Prywatny menedżer haseł synchronizowany z telefonem.",
  "minimum_chrome_version": "127",
  "action": {
    "default_title": "PassHolder",
    "default_popup": "popup.html"
  },
  "permissions": [
    "storage",
    "clipboardWrite",
    "clipboardRead",
    "alarms",
    "offscreen",
    "activeTab",
    "scripting",
    "unlimitedStorage"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["save-prompt.html"],
      "matches": ["https://*/*", "http://*/*"],
      "use_dynamic_url": true
    }
  ],
  "commands": {
    "fill-login": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "Wypełnij login na tej stronie"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
