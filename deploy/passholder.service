[Unit]
Description=PassHolder sync server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=passholder
Group=passholder
WorkingDirectory=/opt/pass-holder/server
EnvironmentFile=/etc/passholder/passholder.env
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning src/main.ts
Restart=on-failure
RestartSec=5

# Hardening: the server may only write its database directory.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ReadWritePaths=/var/lib/passholder
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
